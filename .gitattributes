# Normalize all text files to LF in the repository, regardless of the
# checkout platform. Prevents the whole tree showing as modified when an
# editor rewrites files to CRLF.
* text=auto eol=lf

# Explicit binaries — never touched by line-ending normalization.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.otf  binary
*.ttf  binary
*.webm binary
*.mp4  binary

# GIFs tracked via Git LFS.
*.gif filter=lfs diff=lfs merge=lfs -text
